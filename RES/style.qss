/* Jar-IDE global stylesheet - dark glass */
* { font-family: "Segoe UI", "Microsoft YaHei", sans-serif; outline: none; }
QMainWindow, QDialog { background-color: #0d1117; color: #e6edf3; }
#welcomeRoot { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #0b1020, stop:0.5 #0d1117, stop:1 #0a1a24); }
QFrame#card { background-color: rgba(255,255,255,18); border: 1px solid rgba(255,255,255,28); border-radius: 18px; }
QFrame#card:hover { background-color: rgba(124,92,255,42); border: 1px solid rgba(124,92,255,120); }
QLabel#brandTitle { font-size: 44px; font-weight: 700; color: #fff; }
QLabel#brandSub { font-size: 15px; color: #8b98a9; }
QLabel#cardTitle { font-size: 19px; font-weight: 600; color: #fff; }
QLabel#cardDesc { font-size: 12px; color: #9aa7b5; }
QPushButton { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #7c5cff, stop:1 #22d3ee); color:#fff; border:none; border-radius:10px; padding:9px 20px; font-size:13px; font-weight:600; }
QPushButton:hover { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #8d6dff, stop:1 #33e3ff); }
QPushButton#ghost { background-color: rgba(255,255,255,22); color:#e6edf3; border:1px solid rgba(255,255,255,40); }
QFrame#sidebar { background-color:#0a0e14; border-right:1px solid #1c2430; }
QTreeView { background:transparent; color:#cdd9e5; border:none; font-size:13px; padding:6px; }
QTreeView::item { min-height:26px; border-radius:6px; }
QTreeView::item:selected { background: rgba(124,92,255,70); color:#fff; }
QTabWidget::pane { border:none; background:#0d1117; }
QTabBar::tab { background:#11161d; color:#9aa7b5; padding:8px 18px; border-top-left-radius:8px; border-top-right-radius:8px; margin-right:2px; }
QTabBar::tab:selected { background:#1b2230; color:#fff; }
QPlainTextEdit, QTextEdit { background:#0d1117; color:#e6edf3; border:none; selection-background-color: rgba(124,92,255,120); font-family:"Consolas",monospace; font-size:14px; }
QPlainTextEdit#output { background:#070a0f; color:#9fe8b0; border-top:1px solid #1c2430; font-family:"Consolas",monospace; font-size:13px; }
QLineEdit { background: rgba(255,255,255,20); border:1px solid rgba(255,255,255,35); border-radius:8px; padding:7px 10px; color:#fff; }
QLineEdit:focus { border:1px solid #7c5cff; }
QLabel { color:#cdd9e5; }
QStatusBar { background:#0a0e14; color:#8b98a9; }
QScrollBar:vertical { background:transparent; width:10px; }
QScrollBar::handle:vertical { background:#2a3444; border-radius:5px; min-height:30px; }
#titleBar { background-color:#0a0e14; border-bottom:1px solid #1c2430; }
QLabel#titleText { color:#cdd9e5; font-size:12px; font-weight:600; padding-left:6px; }
QPushButton#winBtnMin, QPushButton#winBtnMax { background:transparent; color:#9aa7b5; border:none; border-radius:6px; font-size:13px; }
QPushButton#winBtnMin:hover, QPushButton#winBtnMax:hover { background: rgba(255,255,255,30); color:#fff; }
QPushButton#winBtnClose { background:transparent; color:#9aa7b5; border:none; border-radius:6px; font-size:12px; }
QPushButton#winBtnClose:hover { background:#e81123; color:#fff; }
